# ==============================================================================
# 1. DATABASE
# ==============================================================================
# Local (Docker Compose) :
DATABASE_URL=postgresql://kenza:kenza_dev_password_123@localhost:5433/kenza_db
# Distant (Render/Railway — PostgreSQL managé, fourni automatiquement par la
# plateforme via render.yaml / le plugin Postgres Railway, à copier ici pour
# les commandes locales type `npm run db:migrate` contre la base distante) :
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ==============================================================================
# 2. LLM & EMBEDDINGS
# ==============================================================================
ANTHROPIC_API_KEY=

# Optional
GROQ_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# 3. WHATSAPP / MESSAGING
# ==============================================================================
# WhatsApp Cloud API (required — used by src/lib/whatsapp.ts)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Twilio (optional — alternate messaging provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# 4. AUTHENTICATION
# ==============================================================================
NEXTAUTH_SECRET=
# Local :
NEXTAUTH_URL=http://localhost:3000
# Distant (Render : https://<service>.onrender.com — Railway : https://<service>.up.railway.app,
# ou votre domaine custom) :
# NEXTAUTH_URL=https://kenza-app.onrender.com

# ==============================================================================
# 5. APPLICATION
# ==============================================================================
# Local :
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Distant (Render/Railway) :
# NODE_ENV=production
# PORT=3000
# NEXT_PUBLIC_API_URL=https://kenza-app.onrender.com

# ==============================================================================
# 6. LANGGRAPH CHECKPOINTS
# ==============================================================================
CHECKPOINT_STORAGE=postgresql
CHECKPOINT_TTL=3600

# ==============================================================================
# 7. LOGGING
# ==============================================================================
# debug | info | warn | error
LOG_LEVEL=info

# ==============================================================================
# 8. FEATURES
# ==============================================================================
ENABLE_RAG=false
ENABLE_OCR=false
ENABLE_PDF_REPORTS=false
ENABLE_HUMAN_REVIEW=false

# ==============================================================================
# 9. BUSINESS RULES
# ==============================================================================
TAX_RATE=0.20
DELIVERY_FEE_MAD=80
MIN_ORDER_MAD=0
DISCOUNT_MAX_PERCENT=15
HIGH_VALUE_THRESHOLD_MAD=20000
